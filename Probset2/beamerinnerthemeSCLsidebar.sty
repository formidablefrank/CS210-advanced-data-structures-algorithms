\newcommand{\sclaffiliation}[0]{Scientific Computing Laboratory\\Department of Computer Science\\University of the Philippines Diliman}

% colored hyperlinks
\newcommand{\tref}[1]{%
	\href{{mailto:}#1}{{\usebeamercolor[fg]{title}\tt #1}}%
}
	
\newcommand{\chref}[2]{\href{#1}{{\usebeamercolor[fg]{structure}#2}}}

\def\event#1{\gdef\@event{#1}}
