%-----------------------------------------------  
\def\maketitle{\ifbeamer@inframe\titlepage\else\frame[plain]{\titlepage}\fi}


\def\singleauthor{\def\titlepage{\usebeamertemplate{titlepage1}}}
\def\multiauthors{\def\titlepage{\usebeamertemplate{titlepage2}}}


\setbeamertemplate{titlepage1}{%
	\begin{minipage}[b][\paperheight]{\textwidth}
	\vspace*{11mm}
	%\includegraphics[height=1.4cm]{lablogo}\par
	%\vspace*{19mm}
		\ifx\insertsubtitle\@empty%
			{\usebeamerfont{title} \usebeamercolor[fg]{title}
		 	\inserttitle\par}%
			{\usebeamerfont{subtitle} \usebeamercolor[fg]{title}
			\par}\vspace*{12mm}%
		\else%
			{\usebeamerfont{title} \usebeamercolor[fg]{title}
		 	\inserttitle\par}%
			{\usebeamerfont{subtitle} \usebeamercolor[fg]{title}
			\insertsubtitle\par}%
		\fi%
  		\vspace*{12mm}

  		\ifx\insertdate\@empty%
  		\else%
  			{\usebeamerfont{date} \usebeamercolor[fg]{date}
  			\ifx\@event\@empty{SCL Presentation\\\insertdate}\else{\@event\\\insertdate}\fi\par}%
  		\fi% 
  				
		\vfill

		
		\ifx\insertauthor\@empty%
		\else%
			{\usebeamerfont{author} \usebeamercolor[fg]{author}
			\insertauthor\par}%
		\fi%
		\ifx\insertinstitute\@empty%
		\else%
			\vspace*{0.5mm}
			{\usebeamerfont{institute} \usebeamercolor[fg]{institute}
			\insertinstitute\par}%
		\fi% 
		\vspace*{7mm}
	\end{minipage}
}

   
\setbeamertemplate{titlepage2}{%
	\begin{minipage}[b][\paperheight]{\textwidth}
	\vspace*{11mm}
	%\includegraphics[height=1.4cm]{lablogo}\par
	%\vspace*{19mm}
		\ifx\insertsubtitle\@empty%
			{\usebeamerfont{title} \usebeamercolor[fg]{title}
		 	\inserttitle\par}%
			{\usebeamerfont{subtitle} \usebeamercolor[fg]{title}
			\par}\vspace*{12mm}%
		\else%
			{\usebeamerfont{title} \usebeamercolor[fg]{title}
		 	\inserttitle\par}%
			{\usebeamerfont{subtitle} \usebeamercolor[fg]{title}
			\insertsubtitle\par}%
		\fi%
		
		\vfill

		
		\ifx\insertauthor\@empty%
		\else%
			{\usebeamerfont{author} \usebeamercolor[fg]{author}
			\insertauthor\par}%
		\fi%
		\ifx\insertinstitute\@empty%
		\else%
			\vspace*{0.5mm}
			{\usebeamerfont{institute} \usebeamercolor[fg]{institute}
			\insertinstitute\par}%
		\fi% 
 		\vspace*{7mm}

 		\ifx\insertdate\@empty%
 		\else%
 			{\usebeamerfont{date} \usebeamercolor[fg]{date}
 			\ifx\@event\@empty{SCL Presentation\\\insertdate}\else{\@event\\\insertdate}\fi\par}%
 		\fi% 
		\vspace*{7mm}
	\end{minipage}
}

%final page
\defbeamertemplate*{final page}{text}[1]{%
\ifx\beamer@sidebarside\beamer@lefttext% sidebar on the left
  \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@leftsidebar}%
  \hskip-\beamer@leftsidebar%
\else% sidebar on the right
  \setlength{\beamer@plainpagewidth}{\textwidth+\beamer@rightsidebar}%
\fi%
\begin{minipage}[c][\textheight][c]{\beamer@plainpagewidth}
  \vfill
  \centering
  \textcolor{SCLdarkblue}{#1}
  \vfill
  {\inserttitlegraphic}
  \vspace*{\baselineskip}
\end{minipage}
}

\newcommand{\SCLendpagebg}{%
  \setbeamertemplate{background}{
    \includegraphics[width=\paperwidth,height=\paperheight]{graphics/SCLbg}
    \tikz[overlay] \fill[fill opacity=0.15,fill=SCLdarkblue] (0,0) rectangle (-\paperwidth,\paperheight);
  }
}

\newcommand{\finalpage}[1]{
\setbeamertemplate{final page}[text]{\Large #1}
\usebeamertemplate{final page}
}
