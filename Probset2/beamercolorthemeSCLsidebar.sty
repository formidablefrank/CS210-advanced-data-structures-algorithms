\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeSCLsidebar}[2015/11/15 v1.2.1 The SCL Sidebar Beamer Theme]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theme options and definitions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%beamer specific options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\mode<presentation>%refers to the first four modes (beamer,handout,second and trans). That is, to all modes except the article mode
{
\definecolor{UPmaroon}{RGB}{142,23,26}
\definecolor{SCLdarkblue}{RGB}{16,55,87}
\definecolor{SCLdarkblue1}{RGB}{0,38,93}
\definecolor{SCLdarkblue2}{RGB}{0,46,90}
\definecolor{SCLdarkblue3}{RGB}{29,59,88}
\definecolor{SCLlightblue}{RGB}{0,105,168}
\definecolor{SCLgray}{RGB}{180,185,190}
\definecolor{SCLgraytext}{RGB}{40,35,30}
\definecolor{SCLgrayblue}{RGB}{84,97,110}
  
\setbeamercolor{SCLsidebar}{fg=SCLgray,bg=SCLdarkblue}
\setbeamercolor{structure}{fg=SCLdarkblue!40!SCLlightblue,bg=SCLlightblue}
\setbeamercolor{headercolor}{bg=white}
\setbeamercolor{barcolor}{fg=black!55,bg=gray!70}
\setbeamercolor{frametitle}{fg=SCLdarkblue, bg=gray}
\setbeamercolor{normal text}{fg=SCLgraytext!78,bg=SCLgray!30}
%\setbeamercolor{alerted text}{fg=SCLlightblue}

\setbeamercolor{title}{fg=structure.fg}
\setbeamercolor{author}{fg=SCLgraytext}
\setbeamercolor{date}{fg=SCLgraytext!80}
\setbeamercolor{institute}{fg=SCLgraytext!85}
\setbeamercolor{sidebar}{bg=SCLdarkblue}
\setbeamercolor{title in sidebar}{fg=white}
\setbeamercolor{author in sidebar}{fg=white!70!SCLdarkblue} 
\setbeamercolor{section in sidebar}{fg=white!70!SCLdarkblue}
\setbeamercolor{subsection in sidebar}{fg=white!92!SCLdarkblue}

 
  
\newcommand{\useSCLmaroonscheme}[0]{
	\setbeamercolor{structure}{fg=UPmaroon}   
	\setbeamercolor{headercolor}{bg=white}
	\setbeamercolor{barcolor}{fg=black!55,bg=gray!70}
	\setbeamercolor{normal text}{fg=SCLgraytext,bg=SCLgray!38}
	\setbeamercolor{frametitle}{fg=UPmaroon, bg=SCLgray}
	\setbeamercolor{SCLsidebar}{fg=SCLgray,bg=UPmaroon}
	\setbeamercolor{title}{fg=UPmaroon}
	\setbeamercolor{author}{fg=SCLgraytext}
	\setbeamercolor{date}{fg=SCLgraytext!80}
	\setbeamercolor{institute}{fg=SCLgraytext!85}
	\setbeamercolor{sidebar}{bg=UPmaroon}
	\setbeamercolor{title in sidebar}{fg=white}
	\setbeamercolor{author in sidebar}{fg=white!88!UPmaroon} 
	\setbeamercolor{section in sidebar}{fg=white!92!UPmaroon}
	\setbeamercolor{subsection in sidebar}{fg=white!92!UPmaroon}
}
  
\newcommand{\darktitlepagebg}[0]{
	\setbeamercolor{title}{fg=white}
	\setbeamercolor{author}{fg=white!95!structure.fg}
	\setbeamercolor{date}{fg=gray!12}
	\setbeamercolor{institute}{fg=white!85!structure.fg}
} 

}%end of beamer specific options

\mode<all>
